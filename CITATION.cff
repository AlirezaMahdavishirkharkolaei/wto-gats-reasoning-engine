    given-names: "Alireza"
version: 2.0.0
date-released: 2026-11-15
license: MIT
repository-code: "https://github.com/AlirezaMahdavishirkharkolaei/wto-gats-reasoning-engine"
keywords:
  - WTO
  - GATS
  - trade in services
  - international economic law
  - digital trade
  - EU Data Act
  - legal technology
